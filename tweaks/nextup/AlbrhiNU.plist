<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">
<dict>
    <!-- Nothing pinned here. Six of the seven targets are Apple or Google apps whose
         CFBundleVersion does not track a single App Store number the way Instagram's
         does, and the tweak is written against the private class stacks of specific
         builds rather than against a version string. Upstream pins YouTube 21.32.4 and
         YouTube Music 9.28.4 in its own headers, and a DEBUG-only probe in each
         provider hook logs which class or selector went missing after an app update
         instead of leaving the row silently blank. -->

    <key>Filter</key>
    <dict>
        <key>Bundles</key>
        <array>
            <!-- The display side. MediaRemoteUI draws the now-playing UI that the
                 Lock Screen and Control Center host; SpringBoard owns the Lock Screen
                 and Dynamic Island hooks themselves. -->
            <string>com.apple.MediaRemoteUI</string>
            <string>com.apple.springboard</string>

            <!-- The providers: one per media app, each reading that app's own queue
                 and serving it over a mach service. -->
            <string>com.apple.Music</string>
            <string>com.apple.podcasts</string>
            <string>com.google.ios.youtube</string>
            <string>com.google.ios.youtubemusic</string>
            <string>com.spotify.client</string>
            <string>com.soundcloud.TouchApp</string>
        </array>
    </dict>

    <!-- No SCIPanelGroup* keys, deliberately. They told Albrhi Panel to draw a row for this
         tweak and push to a page inside its bundle; Albrhi NextUp ships its own Settings row and its
         own preference bundle now, so the panel has nothing to say about it. Albrhi is the
         social-app tweak; this is a separate one. -->
	<!-- And nothing at all in Albrhi's panel.

	     Without this the panel would still find this filter beside its dylib and draw a row
	     per process in it (“SpringBoard”, “Music”, “Spotify”), which is the exact mistake the
	     group keys above used to prevent, arriving from the other direction now that the page
	     has moved out of that bundle. Albrhi NextUp has its own row in Settings; Albrhi is the
	     social-app tweak and has nothing to say about this one. -->
	<key>SCIPanelHidden</key>
	<true/>
</dict>
</plist>
