#!/bin/sh
# Stops the service. A removal (not an upgrade) also forgets the pairing, so a package that is gone leaves no secret behind.
if command -v jbroot >/dev/null 2>&1; then
    PLIST="$(jbroot /Library/LaunchDaemons)/com.albrhi.mirrord.plist"
else
    PLIST="/var/jb/Library/LaunchDaemons/com.albrhi.mirrord.plist"
fi
launchctl unload "$PLIST" 2>/dev/null
pkill -x albrhi-mirrord 2>/dev/null
rm -f "$PLIST"
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    rm -f /var/mobile/Library/Preferences/com.albrhi.mirror.pairing
fi
exit 0
