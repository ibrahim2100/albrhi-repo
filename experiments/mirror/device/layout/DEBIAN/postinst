#!/bin/sh
# Makes albrhi-mirrord start by itself now and after every restart. The path of the binary is resolved here, on the phone,
# because a roothide jailbreak has a different random root on every device and a plist cannot carry a path it does not know.
if command -v jbroot >/dev/null 2>&1; then
    BIN="$(jbroot /usr/bin/albrhi-mirrord)"
    DIR="$(jbroot /Library/LaunchDaemons)"
    APP="$(jbroot /Applications/AlbrhiMirror.app)"
else
    BIN="/var/jb/usr/bin/albrhi-mirrord"
    DIR="/var/jb/Library/LaunchDaemons"
    APP="/var/jb/Applications/AlbrhiMirror.app"
fi
PLIST="$DIR/com.albrhi.mirrord.plist"

mkdir -p "$DIR"
cat > "$PLIST" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.albrhi.mirrord</string>
    <key>ProgramArguments</key>
    <array>
        <string>$BIN</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>20</integer>
    <key>StandardOutPath</key>
    <string>/tmp/albrhi-mirrord.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/albrhi-mirrord.log</string>
</dict>
</plist>
PLISTEOF
chmod 644 "$PLIST"
chown root:wheel "$PLIST" 2>/dev/null

# Replace a running copy (an upgrade, or one started by hand), then start the service.
launchctl unload "$PLIST" 2>/dev/null
pkill -x albrhi-mirrord 2>/dev/null
launchctl load -w "$PLIST" 2>/dev/null

# The app that switches mirroring on and off and shows the pairing code: put its icon on the home screen.
# The pairing file of version 0.2.0 lived in Preferences; the daemon keeps its state in its own folder now.
rm -f /var/mobile/Library/Preferences/com.albrhi.mirror.pairing
if command -v uicache >/dev/null 2>&1 && [ -d "$APP" ]; then
    uicache -p "$APP" >/dev/null 2>&1
fi
exit 0
