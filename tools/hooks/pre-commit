#!/usr/bin/env bash
# Runs the source and repository checks before a commit is made, so a "+N" version, a stale README
# badge or a suite that was not bumped is caught here and not after a five-minute CI round trip.
#   bash tools/install-hooks.sh        (once per clone)
# Skip for one commit only with `git commit --no-verify`.
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 tools/check.py > /tmp/albrhi-check.out 2>&1
status=$?
if [ $status -ne 0 ]; then
  grep -E "FAIL|FAILED" /tmp/albrhi-check.out | head -20
  echo
  echo "pre-commit: the checks failed (full output: /tmp/albrhi-check.out)"
  exit 1
fi
